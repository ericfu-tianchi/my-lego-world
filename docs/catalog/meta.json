   "zh": "圆锥、圆顶、碟",
   "en": "Cones, domes, dishes",
   "blurb": "塔尖、穹顶、伞、灯笼盖。"
  },
  {
   "id": "arch",
   "zh": "拱与围栏",
   "en": "Arches & fences",
   "blurb": "桥、骑楼拱廊、栏杆。"
  },
  {
   "id": "window",
   "zh": "门窗",
   "en": "Windows & doors",
   "blurb": "人仔尺度建筑用；微缩尺度用透明板代替。"
  },
  {
   "id": "bar",
   "zh": "杆件与小配件",
   "en": "Bars & small details",
